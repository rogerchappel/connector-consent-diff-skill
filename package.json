{
  "name": "connector-consent-diff-skill",
  "version": "0.1.0",
  "description": "Review connector permission changes before approval.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "connector-consent-diff": "./dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "docs",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "npm run build && node dist/cli.js --help"
  },
  "keywords": [
    "agent-skill",
    "cli",
    "dry-run",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-consent-diff-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-consent-diff-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-consent-diff-skill#readme"
}
